# Wobl Environment Variables
# Copy this file to .env.local and fill in your actual values.
# Do NOT commit .env.local to source control.

# ===== SUPABASE =====
# Get from: https://supabase.com/dashboard -> Your Project -> Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Not used by any current file — kept for when server-side admin
# operations (e.g. a rebuilt admin sync trigger) are added later.
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ===== TMDB (Movies data) =====
# Get from: https://www.themoviedb.org/settings/api
# TMDBProvider checks TMDB_BEARER_TOKEN, TMDB_API_KEY, or TMDB_ACCESS_TOKEN
# — only one of these three needs to be set.
TMDB_API_KEY=your-tmdb-key-here

# ===== STRIPE (Not active yet — monetization is a later-phase decision) =====
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
