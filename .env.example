# NovaHub Environment Variables
# Copy this file to .env.local and fill in your actual values.
# Do NOT commit .env.local to source control.

# ===== SUPABASE (Shared) =====
# Get from: https://supabase.com/dashboard -> Your Project -> Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ===== APP URLS (Environment-specific) =====
# For LOCAL DEVELOPMENT: Use localhost ports
# NEXT_PUBLIC_WEB_APP_URL=http://localhost:3000
# NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# For PRODUCTION (Vercel): Set these in Vercel dashboard
# NEXT_PUBLIC_WEB_APP_URL=https://novahub.app
# NEXT_PUBLIC_ADMIN_URL=https://admin.novahub.app
# NEXT_PUBLIC_SITE_URL=https://novahub.app

# ===== AI / THIRD-PARTY SERVICES (Optional) =====
ANTHROPIC_API_KEY=your-anthropic-key-here
GEMINI_API_KEY=your-gemini-api-key
TMDB_API_KEY=your-tmdb-key-here
RESEND_API_KEY=your-resend-key-here
PRODUCTHUNT_DEVELOPER_TOKEN=your-producthunt-token-here

# ===== INTERNAL SECRETS (Optional) =====
INTERNAL_API_SECRET=your-internal-api-secret
CRON_SECRET=your-cron-secret

# ===== STRIPE (If using payments) =====
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...

# ===== DEPLOYMENT NOTES =====
# LOCAL SETUP: Copy to apps/web/.env.local and apps/admin/.env.local
# VERCEL SETUP: Add variables in Project Settings > Environment Variables
# - Use production URLs (https://novahub.app, https://admin.novahub.app)
# - Service role key is server-only (never exposed)
# - NEXT_PUBLIC_* variables are visible in client code
